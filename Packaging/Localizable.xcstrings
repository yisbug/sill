    "A device %@ asked to pair.": {
      "comment": "配对窗口首行；插值为未命名设备的其他来源说明",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一台设备 %@ 请求配对。"
          }
        }
