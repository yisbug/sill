        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 发送了错误的配对码。还可以再试 %@ 次。"
          }
        }
      }
    },
    "A wrong code came from %@. %lld tries left.": {
      "extractionState": "manual",
