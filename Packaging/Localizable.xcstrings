      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择窗口时可用。"
          }
        }
      }
    },
    "Available once your account is back on this Mac’s screen.": {
      "comment": "文字大小控件的 VoiceOver 提示：只读视图期间不可用",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
