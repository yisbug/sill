{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "comment": "两句之间的连接；中文译为不带空格",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@%2$@"
          }
        }
      }
    },
    "%@ %@ asked to pair.": {
      "comment": "配对窗口首行；插值为设备名和其他来源说明",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ asked to pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 请求配对。"
          }
        }
      }
    },
    "%@ %@ changed signature: expected %@, found %@": {
      "comment": "虚拟显示器设置：系统方法签名变化，插值为类、方法及签名",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ changed signature: expected %3$@, found %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 的签名已更改：应为 %@，实际为 %@"
          }
        }
      }
    },
    "%@ Connected": {
      "comment": "状态卡连接标题，插值为设备简称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接"
          }
        }
      }
    },
    "%@ Devices Connected": {
      "comment": "状态卡连接标题，插值为设备数量",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 台设备已连接"
          }
        }
      }
    },
    "%@ Is Available…": {
      "comment": "状态菜单：有可用更新；插值为版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可用…"
          }
        }
      }
    },
    "%@ Is Ready to Install…": {
      "comment": "状态菜单：更新已就绪、待安装；插值为版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已就绪，可以安装…"
          }
        }
      }
    },
    "%@ Mbps": {
      "comment": "Mac 自定义画质名称，插值为码率\n自定义画质名称；插值为按区域格式化的码率",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mbps"
          }
        }
      }
    },
    "%@ Wants to Pair": {
      "comment": "配对请求标题，插值为设备简称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求配对"
          }
        }
      }
    },
    "%@ and %@": {
      "comment": "设置更新区：两台设备的名称列表",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和 %2$@"
          }
        }
      }
    },
    "%@ and %@ need the USB cable or very fast Wi‑Fi; if the picture lags, step down.": {
      "comment": "Mac 串流设置说明，插值为两种高码率画质名称",
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ and %2$@ need the USB cable or very fast Wi‑Fi; if the picture lags, step down."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和 %@ 需要 USB 连接线或速度很快的 Wi‑Fi；如果画面卡顿，请降低画质。"
          }
        }
      }
    },
    "%@ asked to pair.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求配对。"
          }
        }
      }
    },
    "%@ can no longer connect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法再连接。"
          }
        }
      }
    },
    "%@ can no longer connect. To use it again, pair it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法再连接。如需再次使用，请重新配对。"
          }
        }
      }
    },
    "%@ couldn’t be read: %@": {
      "comment": "设备设置钥匙串读取错误：插值为条目标识和系统错误说明",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ couldn’t be read: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@：%@"
          }
        }
      }
    },
    "%@ couldn’t be saved: %@": {
      "comment": "设备设置钥匙串保存错误：插值为条目标识和系统错误说明",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ couldn’t be saved: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存 %@：%@"
          }
        }
      }
    },
    "%@ didn’t start, so %@ is back.": {
      "comment": "设置更新区：新的每夜构建版没能启动，已退回旧版；插值为新版名称和旧版名称",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ didn’t start, so %2$@ is back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 没能启动，所以已退回 %2$@。"
          }
        }
      }
    },
    "%@ fps · frame age %@ · RTT %@": {
      "comment": "状态卡设备统计，插值为帧率、画面延迟和往返延迟",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ fps · frame age %2$@ · RTT %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fps · 画面延迟 %@ · 往返延迟 %@"
          }
        }
      }
    },
    "%@ fps, still": {
      "comment": "状态卡静止画面帧率，插值为帧率上限",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fps，画面静止"
          }
        }
      }
    },
    "%@ fps, the link can’t carry %@": {
      "comment": "状态卡连接跟不上，插值为帧率和画质",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ fps, the link can’t carry %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fps，连接带宽不足以支持 %@ 画质"
          }
        }
      }
    },
    "%@ fps, the link can’t carry %@ · RTT %@": {
      "comment": "状态卡连接跟不上，插值为帧率、画质和往返延迟",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ fps, the link can’t carry %2$@ · RTT %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fps，连接带宽不足以支持 %@ 画质 · 往返延迟 %@"
          }
        }
      }
    },
    "%@ init returned nil": {
      "comment": "虚拟显示器设置：系统对象初始化失败，插值为类名",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 init 返回了 nil"
          }
        }
      }
    },
    "%@ is available.": {
      "comment": "设置更新区：有可用更新；插值为版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可用。"
          }
        }
      }
    },
    "%@ is locked": {
      "comment": "锁屏覆盖层标题，插值为 Mac 名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已锁定"
          }
        }
      }
    },
    "%@ is locked. Unlock it to see its windows.": {
      "comment": "应用抽屉和设置中的锁屏提示，插值为 Mac 名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已锁定。解锁后即可查看其窗口。"
          }
        }
      }
    },
    "%@ is no longer open.": {
      "comment": "设备菜单：应用已关闭，插值为应用名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭。"
          }
        }
      }
    },
    "%@ is not among the apps ScreenCaptureKit lists": {
      "comment": "音频状态：系统未列出应用，插值为应用名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenCaptureKit 列出的应用中没有 %@"
          }
        }
      }
    },
    "%@ is paired with this Mac.": {
      "comment": "USB 自动配对通知首行；插值为设备名",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已与这台 Mac 配对。"
          }
        }
      }
    },
    "%@ is ready.": {
      "comment": "设置更新区：更新已就绪；插值为版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已就绪。"
          }
        }
      }
    },
    "%@ is restarting Sill to install an update. It reconnects in a moment.": {
      "comment": "设备连接页：Mac 正在重启 Sill 以安装更新，插值为 Mac 名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在重启 Sill 以安装更新。稍后会自动重新连接。"
          }
        }
      }
    },
    "%@ is still paired: Sill couldn’t update the keychain (%@). Try again.": {
      "comment": "USB 配对通知移除失败；插值为设备名和钥匙串故障原因\n设备面板中移除配对失败的警告；插值为设备名和钥匙串故障原因",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is still paired: Sill couldn’t update the keychain (%2$@). Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍处于已配对状态：Sill 无法更新钥匙串（%@）。请重试。"
          }
        }
      }
    },
    "%@ is unchanged.": {
      "comment": "设置更新区：当前版本保持不变；插值为当前版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持不变。"
          }
        }
      }
    },
    "%@ isn’t responding.": {
      "comment": "设备菜单：应用未响应，插值为应用名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未响应。"
          }
        }
      }
    },
    "%@ isn’t signed with Sill’s nightly key yet, so it can’t be installed from here. Try again later.": {
      "comment": "设置更新区：每夜构建版尚未用每夜密钥签名；插值为版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未用 Sill 的每夜密钥签名，所以无法从这里安装。请稍后再试。"
          }
        }
      }
    },
    "%@ ms": {
      "comment": "状态卡时间，插值为毫秒数",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 毫秒"
          }
        }
      }
    },
    "%@ nearby asked to pair.": {
      "comment": "配对窗口首行；插值为附近请求配对的设备名",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近的 %@ 请求配对。"
          }
        }
      }
    },
    "%@ of %@ MB": {
      "comment": "设置更新区：下载进度，插值为已下载和总大小（MB）",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of %2$@ MB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@ MB"
          }
        }
      }
    },
    "%@ of %@ fps": {
      "comment": "状态卡帧率，插值为当前帧率和上限",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ of %2$@ fps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fps，上限 %2$@ fps"
          }
        }
      }
    },
    "%@ on this Mac asked to pair.": {
      "comment": "配对窗口首行；插值为本机请求配对的设备名",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的 %@ 请求配对。"
          }
        }
      }
    },
    "%@ on this network asked to pair.": {
      "comment": "配对窗口首行；插值为通过本地网络请求配对的设备名",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个网络上的 %@ 请求配对。"
          }
        }
      }
    },
    "%@ times": {
      "comment": "Aa 文字大小的 VoiceOver 播报，插值为缩放倍数",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 倍"
          }
        }
      }
    },
    "%@ was installed successfully.": {
      "comment": "设置更新区：更新装好后新版 Sill 显示的绿色提示，插值为版本名称",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已成功安装。"
          }
        }
      }
    },
    "%@ · Retina": {
      "comment": "Mac 画质及分辨率摘要，插值为画质名称\n画质及 Retina 分辨率摘要",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Retina"
          }
        }
      }
    },
    "%@ · Standard": {
      "comment": "Mac 画质及分辨率摘要，插值为画质名称\n画质及标准分辨率摘要",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 标准"
          }
        }
      }
    },
    "%@ — %@ Mbps": {
      "comment": "Mac 画质菜单标题，插值为预设名称和码率\n画质选项标题，插值为预设名称和每秒兆比特数",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — %2$@ Mbps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — %@ Mbps"
          }
        }
      }
    },
    "%@ — Not connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 未连接"
          }
        }
      }
    },
    "%@, %@": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@"
          }
        }
      }
    },
    "%@, %@ and %lld more": {
      "comment": "设置更新区：三台及以上设备的名称列表，插值为前两台设备名和其余台数",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@ and %3$lld more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@ 以及另外 %3$lld 台设备"
          }
        }
      }
    },
    "%@.": {
      "comment": "设备音频提示：完整错误句的句末标点",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。"
          }
        }
      }
    },
    "%@. Quit and reopen Sill to try again.": {
      "comment": "状态卡网络失败说明，插值为错误信息",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。请退出并重新打开 Sill 以重试。"
          }
        }
      }
    },
    "%@×%@ · %@ · %@ Mbps": {
      "comment": "状态卡串流参数，插值为尺寸、帧率和码率",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@×%2$@ · %3$@ · %4$@ Mbps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@×%@ · %@ · %@ Mbps"
          }
        }
      }
    },
    "%g seconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%g second"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%g seconds"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%g 秒"
                }
              }
            }
          }
        }
      }
    },
    "%lld hours after it first finds it": {
      "comment": "设置更新区：等待时间短语，插值为小时数（两小时及以上）",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次发现它的 %lld 小时后"
          }
        }
      }
    },
    "%lld minutes": {
      "comment": "设置更新区：以分钟计的时长（复数变体）；插值为分钟数",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 分钟"
                }
              }
            }
          }
        }
      }
    },
    "%lld minutes after it first finds it": {
      "comment": "设置更新区：等待时间短语（复数变体），插值为分钟数；接在“……自动安装”之后",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minute after it first finds it"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld minutes after it first finds it"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "首次发现它的 %lld 分钟后"
                }
              }
            }
          }
        }
      }
    },
    "%lld windows": {
