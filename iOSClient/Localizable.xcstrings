    "%@ answered with another key, so this %@ didn’t reconnect. Tap it to connect." : {
      "comment" : "连接页或配对提示；插值为Mac 名称、设备类型",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ answered with another key, so this %2$@ didn’t reconnect. Tap it to connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 返回了另一个密钥，因此这台 %@ 未重新连接。轻点以连接。"
          }
        }
      }
    },
    "%@ answered, but Sill isn’t accepting remote connections there. Check that Sill is open and Remote Access is on. If you changed its port, connect at home once." : {
      "comment" : "连接页远程连接失败提示，插值为Mac 名称",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已响应，但那里的 Sill 未接受远程连接。请确认 Sill 已打开且远程访问已开启。如果你更改过端口，请在家时连接一次。"
          }
        }
      }
    },
    "%@ closed the connection. Sill will reconnect when it can." : {
      "comment" : "连接页断开状态；插值为Mac 名称",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已关闭连接。Sill 会在可以连接时重新连接。"
