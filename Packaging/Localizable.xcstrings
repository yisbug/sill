    "Works once, for the next %@:%@.": {
      "comment": "配对码倒计时；插值依次为剩余分钟和两位秒数",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Works once, for the next %1$@:%2$@."
          }
        },
