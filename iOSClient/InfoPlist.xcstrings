        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "本地网络权限说明",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds your Mac on the local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在局域网中找到你的 Mac。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "相机权限说明",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill scans the code on your Mac to pair with it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 需要扫描 Mac 上的配对码来完成配对。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "麦克风权限说明",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill records your voice to type it on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill 会录下你的语音，识别后输入到你的 Mac。"
          }
        }
      }
    }
  },
  "version": "1.0"
