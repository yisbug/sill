        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字过长，无法发送：%@ 最多可接收 %lld KB 的文字。"
          }
        }
      }
    },
    "Too many requests. Open the menu again.": {
      "comment": "设备菜单：请求过多提示",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过多。请重新打开菜单。"
