        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要此权限才能在你的设备上显示窗口。"
          }
        }
      }
    },
    "Needs Accessibility": {
      "comment": "虚拟显示设置中的状态：缺少辅助功能权限",
