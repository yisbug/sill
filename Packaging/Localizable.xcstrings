          }
        }
      }
    },
    "Allow Accessibility for Sill on the Mac (System Settings › Privacy & Security › Accessibility).": {
      "comment": "设备菜单：Mac 辅助功能权限提示",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Mac 上允许 Sill 使用辅助功能（系统设置 › 隐私与安全性 › 辅助功能）。"
          }
        }
      }
    },
    "Allow Accessibility…": {
      "comment": "状态菜单辅助功能权限提醒标题",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用辅助功能…"
          }
        }
      }
    },
    "Allow Screen Recording…": {
      "comment": "状态菜单权限提醒标题",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许屏幕录制…"
