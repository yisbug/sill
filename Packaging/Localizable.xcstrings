    "Away from home": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外出时"
          }
        }
      }
    },
    "Away from home now: %@": {
      "comment": "状态菜单画质副标题，插值为外出画质及分辨率",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前外出时画质：%@"
          }
