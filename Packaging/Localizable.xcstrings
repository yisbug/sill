    "Automatically update Sill": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新 Sill"
          }
        }
      }
    },
    "Automatically update Sill installs releases only.": {
      "comment": "设置更新区：自动更新只安装正式版",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动更新 Sill”只安装正式版。"
          }
        }
      }
    },
    "Automatically update Sill installs releases only: it installs Sill %@ by itself %@ or later, once no device has been connected for %@.": {
      "comment": "设置更新区：自动更新只装正式版，并将在某时刻或之后自动安装；插值为版本号、时刻短语和时长",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Automatically update Sill installs releases only: it installs Sill %1$@ by itself %2$@ or later, once no device has been connected for %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动更新 Sill”只安装正式版：它会在%2$@或之后自行安装 Sill %1$@，前提是已有 %3$@ 没有设备连接。"
          }
        }
      }
    },
    "Automatically update Sill installs releases only: it installs Sill %@ by itself %@, once no device has been connected for %@.": {
      "comment": "设置更新区：自动更新只装正式版，并将在等待一段时间后自动安装；插值为版本号、等待时间短语和时长",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Automatically update Sill installs releases only: it installs Sill %1$@ by itself %2$@, once no device has been connected for %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动更新 Sill”只安装正式版：它会在%2$@自行安装 Sill %1$@，前提是已有 %3$@ 没有设备连接。"
          }
        }
      }
    },
    "Automatically update Sill installs releases only: it installs Sill %@ by itself, once no device has been connected for %@.": {
      "comment": "设置更新区：自动更新只装正式版，并将在无设备连接一段时间后自动安装；插值为版本号和时长",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Automatically update Sill installs releases only: it installs Sill %1$@ by itself, once no device has been connected for %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动更新 Sill”只安装正式版：它会自行安装 Sill %1$@，前提是已有 %2$@ 没有设备连接。"
          }
        }
      }
    },
    "Automatically update Sill is on: Sill downloads a new release %@, then installs it and restarts once no device has been connected for %@; it never disconnects anyone.": {
      "comment": "设置更新区脚注：开启自动更新（含每夜构建版时）的行为；第一个插值为等待时间短语，第二个为时长",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Automatically update Sill is on: Sill downloads a new release %1$@, then installs it and restarts once no device has been connected for %2$@; it never disconnects anyone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动更新 Sill”已开启：Sill 会在%1$@下载新的正式版，然后在已有 %2$@ 没有设备连接后安装并重启；它绝不会断开任何人的连接。"
          }
        }
      }
    },
    "Automatically update Sill is on: Sill downloads a new version %@, then installs it and restarts once no device has been connected for %@; it never disconnects anyone.": {
      "comment": "设置更新区脚注：开启自动更新的行为；第一个插值为等待时间短语，第二个为时长",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Automatically update Sill is on: Sill downloads a new version %1$@, then installs it and restarts once no device has been connected for %2$@; it never disconnects anyone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动更新 Sill”已开启：Sill 会在%1$@下载新版本，然后在已有 %2$@ 没有设备连接后安装并重启；它绝不会断开任何人的连接。"
          }
        }
      }
    },
    "Available": {
      "comment": "虚拟显示设置中的可用状态",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用"
          }
        }
      }
    },
    "Available for a window.": {
